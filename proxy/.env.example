# 이 파일을 .env로 복사해서 채운다. .env는 커밋되지 않는다.
#   cp .env.example .env

# 서울 열린데이터광장 인증키 (필수)
SEOUL_OPEN_DATA_KEY=

# 프록시 접근 토큰 (필수). 만들기: npm run gen-token
# 없으면 프록시가 뜨지 않는다 — 주소를 아는 누구나 인증키 할당량을 쓰게 되니까.
PROXY_TOKEN=

# 아래는 기본값이 있어 생략해도 된다.
# PORT=8787
# CACHE_TTL_MS=300000
# UPSTREAM_TIMEOUT_MS=6000
# MAX_AREAS=12
