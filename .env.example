# 외부 API 키
#
# 주의: 이 값들을 클라이언트 번들에 그대로 넣으면 사용자가 꺼내 쓸 수 있다.
# 실서비스에서는 자체 서버에 프록시를 두고 src/config.ts의 baseUrl을 그쪽으로 돌린다.
# 특히 공공데이터포털 인증키는 일 호출량 제한이 있어 노출되면 바로 소진된다.

# ── 도보 경로 (필수) ────────────────────────────────────
# TMAP 보행자 경로안내 + POI 검색
# 발급: https://openapi.sk.com  (SK open API → 앱 등록 → appKey)
# 네이버는 도보 경로 API를 제공하지 않는다 (Directions 5/15는 자동차 전용)
TMAP_APP_KEY=

# ── 주소 → 좌표 (선택) ──────────────────────────────────
# 네이버 클라우드 플랫폼 Maps 지오코딩
# 발급: https://www.ncloud.com → Console → AI·NAVER API → Maps → Application 등록
NAVER_MAPS_KEY_ID=
NAVER_MAPS_KEY=

# ── 혼잡도 (선택, quiet) ────────────────────────────────
# 서울시 실시간 인구데이터
# 발급: https://data.seoul.go.kr → 로그인 → 인증키 신청
# 없으면 quiet이 중립값(0.5)이 된다
SEOUL_OPEN_DATA_KEY=

# ── 공원·수변 (선택, scenic) ────────────────────────────
# 공공데이터포털 인증키 하나로 도시공원 표준데이터와 건축물대장을 함께 쓴다
# 발급: https://www.data.go.kr → 로그인 → 각 API에서 "활용신청"
#   · 전국도시공원표준데이터
#   · 국토교통부_건축물대장정보 서비스
# Encoding/Decoding 두 가지가 나오는데 URLSearchParams를 쓰므로 Decoding 키를 넣는다
PUBLIC_DATA_SERVICE_KEY=

# ── 건물 높이 (선택, shade) ─────────────────────────────
# 브이월드 2D 데이터 API — 건축물대장은 좌표로 조회가 안 돼서 이쪽이 필요하다
# 발급: https://www.vworld.kr → 오픈API → 인증키 발급 (사용 도메인 등록 필요)
# 없으면 그늘 계산이 기본 건물 높이(15m)로 돌아간다
VWORLD_KEY=
