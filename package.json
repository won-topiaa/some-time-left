{
  "name": "some-time-left",
  "version": "0.1.0",
  "private": true,
  "description": "약속 3분 전에 도착하는 길을 찾아주는 앱인토스 미니앱",
  "scripts": {
    "dev": "granite dev",
    "build": "ait build",
    "build:bundle": "granite build",
    "deploy": "ait deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/ensure-local-config.mjs",
    "predeploy": "npm run build",
    "predev": "node scripts/ensure-local-config.mjs",
    "prebuild": "node scripts/ensure-local-config.mjs",
    "prebuild:bundle": "node scripts/ensure-local-config.mjs",
    "pretypecheck": "node scripts/ensure-local-config.mjs",
    "pretest": "node scripts/ensure-local-config.mjs",
    "link-proxy": "node scripts/link-proxy-token.mjs",
    "store-shots": "node --import ./scripts/ts-resolve.mjs --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-store-shots.mjs",
    "check-config": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-app-config.mjs",
    "precheck-config": "node scripts/ensure-local-config.mjs",
    "set-key": "node scripts/set-key.mjs",
    "preset-key": "node scripts/ensure-local-config.mjs",
    "vworld-layers": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/discover-vworld.mjs",
    "prevworld-layers": "node scripts/ensure-local-config.mjs",
    "probe-tmap": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/probe-tmap.mjs",
    "preprobe-tmap": "node scripts/ensure-local-config.mjs"
  },
  "dependencies": {
    "@apps-in-toss/framework": "^2.10.10",
    "@granite-js/native": "^1.0.42",
    "@granite-js/react-native": "^1.0.42",
    "@toss/tds-react-native": "^2.0.5",
    "brick-module": "^0.5.2",
    "react": "18.2.0",
    "react-native": "0.72.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/runtime": "^7.29.7",
    "@types/react": "^18.2.0",
    "babel-preset-granite": "^1.0.43",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
